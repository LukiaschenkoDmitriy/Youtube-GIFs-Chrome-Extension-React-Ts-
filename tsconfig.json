{
	"compilerOptions": {
		/* Language and Environment */
		"target": "ESNext",
		"jsx": "react-jsx",

		/* Modules */
		"module": "ESNext",
		"moduleResolution": "bundler",
		"rootDir": "./src/ts",
		"paths": {
			"@Base/*": ["./src/ts/base/*"],
			"@PopUp/*": ["./src/ts/popup/*"],
			"@Content/*": ["./src/ts/content/*"],
			"@Background/*": ["./src/ts/background/*"],
			"@Client/*": ["./src/ts/client/*"]
		},

		/* Emit — webpack/babel produces the output, tsc only type-checks */
		"noEmit": true,

		/* Interop Constraints */
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,

		/* Type Checking */
		"strict": true,
		"skipLibCheck": true
	},
	"include": ["./src/**/*"]
}
